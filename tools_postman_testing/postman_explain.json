          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"predictedPrice\": 3525, \"skinId\": 13, \"wearTierId\": 1, \"floatValue\": 0.023, \"isStattrak\": false, \"pattern\": 332, \"stickers\": [1, 6, 65, 5]}"
        },
        "url": {
          "raw": "{{base_url}}/api/ai/explain",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ai",
            "explain"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is JSON', () => pm.response.to.be.json);",
              "pm.test('Has non-empty explanation', () => { const b = pm.response.json(); pm.expect(b).to.have.property('explanation'); pm.expect(b.explanation).to.be.a('string').and.to.have.length.above(10); });"
            ]
          }
        }
      ]
    },
