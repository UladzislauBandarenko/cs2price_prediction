          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', ()=> pm.response.to.have.status(200));",
              "pm.test('Has predicted_price and stickers_features', ()=> { const b = pm.response.json(); pm.expect(b).to.have.property('predicted_price'); pm.expect(b).to.have.property('stickers_features'); const sf = b.stickers_features; pm.expect(sf).to.have.property('stickers_count'); pm.expect(sf).to.have.property('stickers_total_value'); pm.expect(sf).to.have.property('stickers_avg_value'); pm.expect(sf).to.have.property('stickers_max_value'); });"
